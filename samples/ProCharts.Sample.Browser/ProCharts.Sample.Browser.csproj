<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework><OutputType>Exe</OutputType>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath><WasmBuildNative>true</WasmBuildNative>
    <WasmEnableThreads>false</WasmEnableThreads><RunAOTCompilation>false</RunAOTCompilation><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ProCharts.Sample/ProCharts.Sample.csproj" /><PackageReference Include="Avalonia.Browser" /></ItemGroup>
</Project>
