<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProCharts.Sample" xmlns:c="using:ProCharts.Controls"
             x:Class="ProCharts.Sample.MainView" x:DataType="vm:ChartGalleryViewModel"
             vm:GalleryBehavior.Responsive="True" Background="{DynamicResource ChartCardBrush}">
  <UserControl.Styles>
    <Style Selector=":is(UserControl).narrow Border#Sidebar"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector=":is(UserControl).narrow TextBlock.wide"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector=":is(UserControl).narrow WrapPanel#HeaderActions"><Setter Property="Orientation" Value="Vertical" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border BorderBrush="{DynamicResource ChartBorderBrush}" BorderThickness="0,0,0,1" Padding="22,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Background="{DynamicResource ChartAccentBrush}" CornerRadius="7" Padding="9,6">
            <Path Data="M1,16 L1,9 M8,16 L8,2 M15,16 L15,6" Width="19" Height="20" Stroke="White" StrokeThickness="3" Stretch="Uniform" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="ProCharts" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="AVALONIA CHARTING STUDIO" FontSize="9" LetterSpacing="1.5" Foreground="{DynamicResource ChartMutedBrush}" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" Name="HeaderActions" VerticalAlignment="Center">
          <Button Content="Switch template" Command="{Binding TemplateCommand}" Margin="0,0,8,4" AutomationProperties.AutomationId="sample-template" />
          <Button Content="Theme" Command="{Binding ThemeCommand}" AutomationProperties.AutomationId="sample-theme" />
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Name="Body">
      <Border Name="Sidebar" Width="224" BorderBrush="{DynamicResource ChartBorderBrush}" BorderThickness="0,0,1,0" Padding="12,20">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="EXPLORE THE CONTROLS" FontSize="10" LetterSpacing="1.1" FontWeight="SemiBold" Margin="12,0,0,14" Foreground="{DynamicResource ChartMutedBrush}" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Examples}" SelectedItem="{Binding SelectedExample, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="sample-examples">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryExample">
                <StackPanel Margin="4,5" Spacing="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding Description}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ChartMutedBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" BorderBrush="{DynamicResource ChartBorderBrush}" BorderThickness="0,1,0,0" Padding="12,16,12,0">
            <StackPanel Spacing="5">
              <TextBlock Text="ONE LIBRARY. EVERY HOST." FontSize="9" FontWeight="SemiBold" />
              <TextBlock Text="Desktop + WebAssembly" FontSize="11" Foreground="{DynamicResource ChartMutedBrush}" />
              <TextBlock Text="Lookless controls · MVVM" FontSize="11" Foreground="{DynamicResource ChartMutedBrush}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <ScrollViewer Grid.Column="1" Name="WorkspaceScroll" Padding="20,18,20,12"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <c:ChartLayoutPanel FillIndex="1" MinHeight="{Binding Viewport.Height, ElementName=WorkspaceScroll}">
          <StackPanel Margin="0,0,0,16" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Chart workspace" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Classes="wide" Text="Explore the data. Make the controls your own." FontSize="12" Foreground="{DynamicResource ChartMutedBrush}" />
              </StackPanel>
              <TextBlock Classes="wide" Grid.Column="1" Text="{Binding DataSummary}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource ChartMutedBrush}" />
            </Grid>
            <WrapPanel>
              <ComboBox Width="184" Margin="0,0,16,6" ItemsSource="{Binding ChartKinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}"
                        AutomationProperties.AutomationId="sample-kind" AutomationProperties.Name="Chart type" />
              <CheckBox Content="Legend" IsChecked="{Binding ShowLegend}" Margin="0,0,12,6" AutomationProperties.AutomationId="sample-legend" />
              <CheckBox Content="Crosshair" IsChecked="{Binding ShowCrosshair}" Margin="0,0,12,6" AutomationProperties.AutomationId="sample-crosshair" />
              <CheckBox Content="Navigator" IsChecked="{Binding ShowNavigator}" Margin="0,0,12,6" AutomationProperties.AutomationId="sample-navigator" />
              <CheckBox Content="Labels" IsChecked="{Binding ShowLabels}" Margin="0,0,0,6" AutomationProperties.AutomationId="sample-labels" />
            </WrapPanel>
          </StackPanel>
          <c:ProChart Name="Chart" Model="{Binding Model}" Title="{Binding Title}" Subtitle="{Binding Subtitle}"
                      ChartStyle="{Binding ChartStyle}" ShowLegend="{Binding ShowLegend}" ShowCrosshair="{Binding ShowCrosshair}"
                      ShowNavigator="{Binding ShowNavigator}" IsLoading="{Binding IsLoading}" ErrorMessage="{Binding ErrorMessage}"
                      vm:GalleryBehavior.Compact="{Binding IsCompact}" AutomationProperties.AutomationId="main-chart" />
          <WrapPanel Margin="0,14,0,0">
            <Button Content="{Binding StreamCaption}" Command="{Binding StreamCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="sample-stream" />
            <Button Content="Append 32 rows" Command="{Binding AppendCommand}" Margin="0,0,18,6" AutomationProperties.AutomationId="sample-append" />
            <Button Content="Empty" Command="{Binding EmptyCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="sample-empty" />
            <Button Content="Loading" Command="{Binding LoadingCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="sample-loading" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="sample-reload" />
            <Button Content="Error" Command="{Binding ErrorCommand}" Margin="0,0,0,6" AutomationProperties.AutomationId="sample-error" />
          </WrapPanel>
        </c:ChartLayoutPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource ChartBorderBrush}" BorderThickness="0,1,0,0" Padding="22,9">
      <TextBlock Text="Wheel: zoom   ·   Drag: pan   ·   + / −: zoom   ·   Home: fit   ·   Ctrl+Z / Y: history" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ChartMutedBrush}" />
    </Border>
  </Grid>
</UserControl>
