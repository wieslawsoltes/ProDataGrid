<UserControl
    x:Class="DataGridSample.Pages.GeneratedAllColumnKindsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:DataGridSample.Models"
    xmlns:viewModels="clr-namespace:DataGridSample.ViewModels"
    x:DataType="viewModels:GeneratedAllColumnKindsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="GeneratedCellTemplate" x:DataType="models:GeneratedAllColumnKindsRow">
      <Border Padding="6,2" CornerRadius="8" Background="#220078D4">
        <TextBlock Text="{Binding Template}" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="12" RowDefinitions="Auto,*" RowSpacing="8">
    <StackPanel Spacing="4">
      <TextBlock Classes="h2" Text="Generated columns: every definition kind" />
      <TextBlock TextWrapping="Wrap" Text="One attributed model covers all 21 column-definition factories, including templates, formulas, combo boxes, drawing, and hierarchical columns." />
    </StackPanel>
    <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding Items}"
              ColumnDefinitionsSource="{Binding ColumnDefinitions}" FastPathOptions="{Binding FastPathOptions}"
              CanUserSortColumns="True" GridLinesVisibility="All" />
  </Grid>
</UserControl>
